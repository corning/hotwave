# HotWave 配置模板
#
# 推荐位置：~/.hotwave/.env（hotwave init 会自动生成）
# 开发位置：仓库根目录 .env（加载时覆盖 ~/.hotwave/.env）
#
# 所有变量均可省略；未配置的功能会自动跳过。
# 设置后需重启运行时生效。

# ============================================================
# 模型
# ============================================================
# Provider: anthropic | openai | google
# 使用 OpenAI 兼容端点（DeepSeek / Kimi / 智谱等）时填 openai。
# HOTWAVE_PROVIDER=anthropic

# 模型 ID，必须与 Provider 匹配。
# HOTWAVE_MODEL=

# 代理、自建端点或兼容服务地址；留空使用 Provider 默认地址。
# HOTWAVE_BASE_URL=

# 运行时从下面两个变量之一读取 Key（按 Provider 选择）。
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# 覆盖内置的系统提示（A 股分析师人设）。
# AGENT_SYSTEM_PROMPT=

# ============================================================
# 运行时
# ============================================================
# 建议固定为北京时间；心跳阶段与监控时段依赖本机时区。
# TZ=Asia/Shanghai

# HTTP 服务（对话、SSE、控制面、监控上报）
# AGENT_RUNTIME_HOST=127.0.0.1
# AGENT_RUNTIME_PORT=8791
# 设置后所有 HTTP 请求需 Authorization: Bearer <token>
# AGENT_RUNTIME_TOKEN=

# 内嵌 WebSocket RPC 网关（IM / 桌面端 / CLI / 平台）
# HOTWAVE_GW_HOST=127.0.0.1
# HOTWAVE_GW_PORT=18789
# 网关 connect 握手 Token；对外暴露时务必设置
# HOTWAVE_GW_TOKEN=
# 渠道进程连接网关的地址
# HOTWAVE_GW_URL=ws://localhost:18789

# 数据目录（默认 ~/.hotwave），与安装位置和当前目录解耦。
# HOTWAVE_HOME=~/.hotwave
# 工作区（默认 HOTWAVE_HOME/workspace）
# AGENT_WORKSPACE=~/.hotwave/workspace
# 兼容旧别名：HOTWAVE_CONFIG_DIR（与 HOTWAVE_HOME 同义）

# 仅 pnpm dev：home 使用 ~/.hotwave/workspace，也可填绝对路径
# HOTWAVE_DEV_WORKSPACE=home

# 单次 run 的最大轮次与单轮输出上限
# AGENT_MAX_TURNS=6
# AGENT_MAX_TOKENS=8192

# ============================================================
# 交易
# ============================================================
# paper 模拟盘（默认）/ live 实盘
TRADE_MODE=paper

# 实盘第二道开关：只有 TRADE_MODE=live 且此项为 true 才提交真实委托。
LIVE_TRADE_ENABLED=false

# 测试保护：true 时写类交易工具只预演，不触达交易通道。
# TRADE_DRY_RUN=false

# 模拟盘初始资金（元）
PAPER_INITIAL_CASH=1000000

# 风控：单票仓位上限（占总资产比例）、单笔金额上限（元）
MAX_POSITION_RATIO=0.3
MAX_ORDER_AMOUNT=100000

# 实盘专属风控
# 仅允许 A 股交易时段（北京时间 09:25-11:30 / 13:00-15:00）下单
# LIVE_TRADE_SESSION_ONLY=true
# 每日实盘下单次数上限
# MAX_LIVE_ORDERS_PER_DAY=20

# 东方财富实盘账户（仅实盘需要；模拟盘无需填写）
# STOCK_ACCOUNT_USERNAME=
# STOCK_ACCOUNT_PASSWORD=

# 审批策略：always-auto 全部放行（默认）| guarded 写类工具拦截待审批
# APPROVAL_MODE=always-auto

# ============================================================
# 平台绑定与落库（可选）
# ============================================================
# 不配置 TRADE_BINDING_ID / TRADE_BINDING_SECRET 时为独立模式：
# 不建立反向长连接，交易记录、执行日志、心跳简报全部跳过。
#
# 平台 REST API 前缀；行情工具也通过它访问 /api/hotwave/* 端点。
# TRADE_API_BASE=http://localhost:8000/api
# 平台反向 WebSocket 地址。
# TRADE_API_WS_URL=ws://localhost:18791
# 绑定凭证（APP 或管理后台生成后填入）。
# TRADE_BINDING_ID=
# TRADE_BINDING_SECRET=

# ============================================================
# 监控（进程内引擎）
# ============================================================
# 仅当值为 false 时关闭。
# MONITOR_ENABLED=true
# 逗号分隔；默认 sh000001,sz399001,sz399006,sh000688
# MONITOR_INDEX_LIST=sh000001,sz399001,sz399006,sh000688
# 轮询间隔（秒）
# MONITOR_INTERVAL=5
# 毫秒级间隔，优先级高于 MONITOR_INTERVAL
# MONITOR_INTERVAL_MS=5000
# 涨跌幅异动阈值（%）/ 放量倍数
# MONITOR_PRICE_PCT=3.0
# MONITOR_VOLUME_RATIO=2.0
# auto（默认，server_app 优先，失败回落腾讯）| server_app | tencent
# MONITOR_QUOTE_SOURCE=auto

# ============================================================
# 心跳（主动唤醒）
# ============================================================
# 仅当值为 false 时关闭。
# HOTWAVE_HEARTBEAT=true
# 心跳间隔（毫秒），默认 10 分钟
# HOTWAVE_HEARTBEAT_INTERVAL_MS=600000
# 活跃时段（本机时间）
# HEARTBEAT_START=09:00
# HEARTBEAT_END=15:20
# 单轮心跳的工具轮次预算
# HEARTBEAT_MAX_TOOL_TURNS=4
# 巡检文件与状态文件路径（默认在工作区）
# AGENT_HEARTBEAT_FILE=
# AGENT_HEARTBEAT_STATE=

# ============================================================
# IM 渠道（全部可选）
# ============================================================
# 在运行时进程内启动渠道；不设置则可用 pnpm channel:start 独立进程启动。
# CHANNELS_ENABLED=true
# 逗号分隔；留空则自动启动所有已配置凭证的渠道
# CHANNELS=telegram,feishu,dingtalk,wechat

# Telegram
# TELEGRAM_BOT_TOKEN=
# 通知推送目标 chatId，逗号分隔
# TELEGRAM_NOTIFY_TARGETS=

# 飞书
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_VERIFICATION_TOKEN=
# FEISHU_ENCRYPT_KEY=
# FEISHU_NOTIFY_TARGETS=

# 钉钉
# DINGTALK_CLIENT_ID=
# DINGTALK_CLIENT_SECRET=
# DINGTALK_NOTIFY_TARGETS=

# 微信（iLink Bot API）
# WECHAT_BOT_TOKEN=
# WECHAT_BOT_BASE_URL=https://wxbot.weixin.qq.com
# WECHAT_BOT_ACCOUNT_ID=
# WECHAT_NOTIFY_TARGETS=

# ============================================================
# OCR（实盘登录验证码）
# ============================================================
# 指定已安装 ddddocr 的 Python；留空按顺序探测
# ~/.hotwave/venv -> 包根/.venv -> PATH
# HOTWAVE_PYTHON=
# pip 安装源，默认清华镜像
# HOTWAVE_PIP_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple

# ============================================================
# DSH 插件兼容（可选）
# ============================================================
# 逗号分隔的插件包名；也可用 ~/.hotwave/config/dsh-plugins.json
# DSH_PLUGINS=
# 插件清单 JSON 路径
# DSH_PLUGIN_CONFIG=
# 镜像工具名前缀，默认 dsh_；置空则不加前缀
# DSH_TOOL_PREFIX=dsh_
